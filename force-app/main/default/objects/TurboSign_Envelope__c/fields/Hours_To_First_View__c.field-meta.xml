<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Hours_To_First_View__c</fullName>
  <label>Hours To First View</label>
  <type>Number</type>
  <formula>IF(ISBLANK(First_Viewed_On__c) || ISBLANK(Sent_On__c), null, (First_Viewed_On__c - Sent_On__c) * 24)</formula>
  <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
  <precision>18</precision>
  <scale>2</scale>
</CustomField>
