<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Days_To_Sign__c</fullName>
  <label>Days To Sign</label>
  <type>Number</type>
  <formula>IF(ISBLANK(Completed_On__c) || ISBLANK(Sent_On__c), null, (Completed_On__c - Sent_On__c))</formula>
  <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
  <precision>18</precision>
  <scale>2</scale>
</CustomField>
